# Reference only: PHP does not load this file. Set real process/Render environment variables.
# Persistent Windows development: use database\local.ps1, not production values here.
# APP_ENV=development locks connections to 127.0.0.1:55432/exhibit_development.
# APP_ENV=test permits only loopback exhibit_test_SUFFIX databases.
# APP_ENV=production preserves the existing verified-TLS production configuration.
# Render: use the full EXTERNAL hostname for verify-full (internal TLS is self-signed).
# URL-encode the username, password, and database components. Never commit real values.
DATABASE_URL=postgresql://exhibit_user:REPLACE_WITH_URL_ENCODED_PASSWORD@YOUR_DATABASE_HOST:5432/exhibit
DB_SSLMODE=verify-full
# Docker provides this CA bundle. On Windows, set an absolute path to a trusted CA bundle.
DB_SSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
# Local loopback PostgreSQL without TLS only: explicitly set DB_SSLMODE=disable.
# Tests use separate TEST_DATABASE_URL, TEST_DB_SSLMODE, and TEST_DB_SSLROOTCERT variables.
